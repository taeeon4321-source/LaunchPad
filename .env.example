# Copy to .env for local development. In staging/production, inject these from a secret manager; never commit real values.
NODE_ENV=development            # development | production
PORT=8787
APP_ORIGIN=http://localhost:8787 # production: https://your-domain (must be https)

# Database. Empty = embedded PGlite in ./.data (development and tests only). Production: managed PostgreSQL.
DATABASE_URL=
# 32 random bytes, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

SESSION_DAYS=30
SESSION_IDLE_DAYS=7
REAUTH_MINUTES=10

# Google Identity Services (Google Cloud Console > Credentials > OAuth client ID, type "Web application").
# Authorized JavaScript origin: APP_ORIGIN. The client ID is public; there is no client secret in this flow.
GOOGLE_CLIENT_ID=

# Roblox OAuth 2.0 app (Creator Dashboard > OAuth 2.0 apps; requires an ID-verified developer).
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=http://localhost:8787/api/roblox/callback
ROBLOX_SCOPES=openid profile universe:read

# Paddle Billing. Use separate values for sandbox and live; never mix them.
PADDLE_ENV=sandbox              # sandbox | live
PADDLE_API_KEY=                 # server-side secret
PADDLE_CLIENT_TOKEN=            # client-side token (public by design), Paddle > Developer tools > Authentication
PADDLE_WEBHOOK_SECRET=          # from the notification destination pointing at APP_ORIGIN/api/billing/webhook
PADDLE_PRODUCT_LIGHT=
PADDLE_PRODUCT_MAX=
PADDLE_PRICE_LIGHT_MONTHLY=     # $9.99 every 1 month
PADDLE_PRICE_LIGHT_ANNUAL=      # $99.99 every 1 year
PADDLE_PRICE_MAX_MONTHLY=       # $49.99 every 1 month
PADDLE_PRICE_MAX_ANNUAL=        # $200.00 every 1 year
PAST_DUE_GRACE_DAYS=0           # business decision

# Plan limits (business decisions; unset = not limited). Example:
# PLAN_LIMITS_JSON={"light":{"connected_experiences":2,"monthly_scans":100,"sync_interval_minutes":1440},"max":{"connected_experiences":10,"monthly_scans":1000,"sync_interval_minutes":60}}
PLAN_LIMITS_JSON={"light":{"connected_experiences":2,"monthly_scans":30,"sync_interval_minutes":1440},"max":{"connected_experiences":20,"monthly_scans":1000,"sync_interval_minutes":60}}

# Transactional email: outbox (development, nothing sent) | resend
EMAIL_PROVIDER=outbox
EMAIL_API_KEY=
EMAIL_FROM=LaunchPad <no-reply@your-domain>

# Retention (legal review required)
RETENTION_SCAN_SNAPSHOT_DAYS=90
RETENTION_SECURITY_EVENT_DAYS=365
